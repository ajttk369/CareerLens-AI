OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Counts analysis attempts across the entire deployment, not per user.
ANALYSIS_DAILY_LIMIT=30

# Optional stable secret (at least 32 random bytes). Never use NEXT_PUBLIC_.
# ANALYSIS_SIGNING_SECRET=your_random_server_only_secret

# A fixed fictional sample; no OpenAI requests or result storage.
MOCK_ANALYSIS=false
